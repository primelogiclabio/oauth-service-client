{
  "realm": "oauth-service-client-it",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "users": [
    {
      "username": "jane",
      "enabled": true,
      "email": "jane@example.com",
      "emailVerified": true,
      "firstName": "Jane",
      "lastName": "Doe",
      "credentials": [
        {
          "type": "password",
          "value": "jane-dev-password",
          "temporary": false
        }
      ],
      "federatedIdentities": [
        {
          "identityProvider": "assertion-issuer",
          "userId": "jane-ext",
          "userName": "jane"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "service-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "service-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "jwt-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "use.jwks.url": "false",
        "jwt.credential.certificate": ""
      }
    },
    {
      "clientId": "jwt-ec-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "use.jwks.url": "false",
        "jwt.credential.certificate": ""
      }
    },
    {
      "clientId": "mtls-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-x509",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "x509.subjectdn": ".*CN=test-client.*",
        "x509.allow.regex.pattern.comparison": "true",
        "tls.client.certificate.bound.access.tokens": "true"
      }
    },
    {
      "clientId": "password-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "password-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "https://jwt-bearer-client.example.com",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "jwt-bearer-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "assertion-issuer"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "assertion-issuer",
      "providerId": "jwt-authorization-grant",
      "enabled": true,
      "config": {
        "issuer": "https://jwt-bearer-client.example.com",
        "useJwksUrl": "false",
        "publicKeySignatureVerifier": "",
        "jwtAuthorizationGrantEnabled": "true",
        "jwtAuthorizationGrantAllowedClockSkew": "5"
      }
    }
  ]
}
