# Build output
target/
.flattened-pom.xml

# IDE
*.iml
.idea/
.vscode/
.classpath
.project
.settings/

# Secrets and keys: never commit real ones
.env
*.env
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
keys/
# ...except the throwaway test fixtures the tests load (generated by src/test/resources/tls/generate.sh, used nowhere else)
!src/test/resources/tls/*.key
!src/test/resources/tls/*.p12

# Local settings that may hold client secrets or tenant details
*.local.properties
CLAUDE.local.md
