<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.primelogiclab</groupId>
    <artifactId>oauth-service-client</artifactId>
    <!--
        Two flavors from one source tree, Guava-style: X.Y.Z for Java 21 (the default build) and X.Y.Z-jdk8 for
        Java 8 to 20 (-Pjdk8). Releases set the version from the tag: -Drevision=X.Y.Z[-jdk8] -Dchangelist=
    -->
    <version>${revision}${changelist}</version>
    <packaging>jar</packaging>

    <name>oauth-service-client</name>
    <description>Java library for backend services that call OAuth-protected external APIs (DocuSign, Salesforce, Jira, ...): it gets and caches access tokens per service and tenant and makes the request.</description>
    <url>https://github.com/primelogiclabio/oauth-service-client</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>primehojox</id>
            <name>Andrew H</name>
            <organization>primelogiclabio</organization>
            <organizationUrl>https://github.com/primelogiclabio</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/primelogiclabio/oauth-service-client.git</connection>
        <developerConnection>scm:git:https://github.com/primelogiclabio/oauth-service-client.git</developerConnection>
        <url>https://github.com/primelogiclabio/oauth-service-client</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/primelogiclabio/oauth-service-client/issues</url>
    </issueManagement>

    <!--
        From 1.1.0 releases and snapshots go to repo.primelogiclab.io (Reposilite); 1.0.0 stays on Maven Central
        only. The ids match the <server> entries in settings.xml.
    -->
    <distributionManagement>
        <repository>
            <id>primelogiclab-releases</id>
            <url>https://repo.primelogiclab.io/releases</url>
        </repository>
        <snapshotRepository>
            <id>primelogiclab-snapshots</id>
            <url>https://repo.primelogiclab.io/snapshots</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <revision>1.2.0</revision>
        <changelist>-SNAPSHOT</changelist>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- The Java 21 flavor; the jdk8 profile switches both to the Java 8 flavor -->
        <java.release>21</java.release>
        <caffeine.version>3.3.1</caffeine.version>
        <release.versionPattern>\d+\.\d+\.\d+</release.versionPattern>
        <!-- Only JDK 8's javac reads these; on JDK 9+ the compiler-release profile sets release instead -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- the license travels with the jar -->
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
            </plugin>
            <!--
                The published POM gets the real version, this flavor's Caffeine version and no profiles, so each
                flavor's consumers see only what applies to them.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.9.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.primelogiclab.oauthclient</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- A javadoc jar goes out with every release; every doclint warning fails the build, so none creep in -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <quiet>true</quiet>
                    <additionalOptions>
                        <additionalOption>-Xmaxwarns</additionalOption>
                        <additionalOption>10000</additionalOption>
                    </additionalOptions>
                    <!--
                        src/main/java only: src/main/java11 holds just the package-private PATCH transport, which
                        is built for Java 11 while javadoc runs with release 8
                    -->
                    <sourcepath>${project.basedir}/src/main/java</sourcepath>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            On JDK 9+ compile with release, so the API surface is checked against the flavor's Java version, not
            just the bytecode level.
        -->
        <profile>
            <id>compiler-release</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>${java.release}</maven.compiler.release>
            </properties>
        </profile>
        <!--
            The Java 8 flavor (X.Y.Z-jdk8): built for Java 8, on Caffeine 2.9.x, the last line that runs on Java 8.
            -Pjdk8 on a newer JDK; on JDK 8 itself it is the only flavor that builds, so it turns on there.
        -->
        <profile>
            <id>jdk8</id>
            <activation>
                <jdk>1.8</jdk>
            </activation>
            <properties>
                <java.release>8</java.release>
                <caffeine.version>2.9.3</caffeine.version>
                <release.versionPattern>\d+\.\d+\.\d+-jdk8</release.versionPattern>
            </properties>
        </profile>
        <!--
            On JDK 11+ also compile src/main/java11 (the PATCH transport on java.net.http) with release 11,
            into the same classes, in both flavors. The class is only loaded by name on a Java 11+ runtime, so the
            Java 8 flavor still runs on Java 8; built on JDK 8, PATCH reports that it needs Java 11. Releases are
            built on JDK 21.
        -->
        <profile>
            <id>java11-patch</id>
            <activation>
                <jdk>[11,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-java11</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <release>11</release>
                                    <compileSourceRoots>
                                        <compileSourceRoot>${project.basedir}/src/main/java11</compileSourceRoot>
                                    </compileSourceRoots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                        After compiling, add src/main/java11 as a source root so the sources jar has the PATCH
                        transport too; added earlier, the release 8 compile would try to build it.
                    -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.8.0</version>
                        <executions>
                            <execution>
                                <id>java11-sources-in-sources-jar</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/main/java11</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Release checks and signing, for the release workflow only (-Prelease), so local builds never need the
            key. The upload itself is the plain deploy to distributionManagement.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- A version that doesn't match its flavor can't be replaced: the repository refuses redeploys -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>release-checks</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>project.version</property>
                                            <regex>${release.versionPattern}</regex>
                                            <regexMessage>Version ${project.version} doesn't match this flavor (${release.versionPattern}): X.Y.Z for Java 21, X.Y.Z-jdk8 with -Pjdk8</regexMessage>
                                        </requireProperty>
                                        <requireJavaVersion>
                                            <version>[21,)</version>
                                            <message>Releases are built on JDK 21, so both flavors include the PATCH class</message>
                                        </requireJavaVersion>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
